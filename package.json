{
  "name": "riu-stories",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "lint": "node scripts/lint-check.mjs",
    "perf": "node scripts/performance-benchmark.mjs",
    "perf:baseline": "node scripts/performance-benchmark.mjs --output artifacts/performance/baseline.json",
    "perf:compare": "node scripts/performance-compare.mjs",
    "visual:capture": "node scripts/visual-quality-capture.mjs",
    "prepare-codecs": "node scripts/copy-three-codecs.mjs",
    "predev": "npm run prepare-codecs",
    "dev": "vite --force --port 3005",
    "prebuild": "npm run prepare-codecs",
    "build": "vite build",
    "postbuild": "node scripts/copy-static-assets.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@panzoom/panzoom": "^4.6.1",
    "@supabase/supabase-js": "^2.112.3",
    "gsap": "^3.12.7",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.170.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.13"
  }
}
